# ==========================================
# ATS Resume Scorer Environment Variables
# ==========================================

# 1. AI API Configuration (Groq for LLM Resume Analysis & Parsing)
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# 2. Backend URL (used by Streamlit frontend)
BACKEND_URL=http://localhost:8000

# 3. Supabase Auth & Database (Optional - falls back to Local Demo Mode)
# Create a project at: https://supabase.com
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_KEY=
SUPABASE_JWT_SECRET=

# 4. Admin / Owner Dashboard (Optional)
OWNER_EMAIL=
OWNER_EMAILS=
ENABLE_MOCK_AUTH=true
